<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modelo 3D</title>
    <!-- Importar el componente Model Viewer -->
    <script type="module" src="https://googleapis.com"></script>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: transparent;
        }
        model-viewer {
            width: 100%;
            height: 400px; /* Puedes ajustar la altura según tus necesidades */
        }
    </style>
</head>
<body>

    <!-- Visor 3D con controles de cámara y rotación automática -->
    <model-viewer 
        src="https://ruta-a-tu-modelo.glb" 
        alt="Modelo 3D" 
        auto-rotate 
        camera-controls>
    </model-viewer>

</body>
</html>
